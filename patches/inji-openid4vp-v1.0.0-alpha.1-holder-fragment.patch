diff --git a/kotlin/openID4VP/src/commonMain/kotlin/io/mosip/openID4VP/authorizationResponse/unsignedVPToken/types/ldp/UnsignedLdpVPTokenBuilder.kt b/kotlin/openID4VP/src/commonMain/kotlin/io/mosip/openID4VP/authorizationResponse/unsignedVPToken/types/ldp/UnsignedLdpVPTokenBuilder.kt
index 0ad2411..29ccf76 100644
--- a/kotlin/openID4VP/src/commonMain/kotlin/io/mosip/openID4VP/authorizationResponse/unsignedVPToken/types/ldp/UnsignedLdpVPTokenBuilder.kt
+++ b/kotlin/openID4VP/src/commonMain/kotlin/io/mosip/openID4VP/authorizationResponse/unsignedVPToken/types/ldp/UnsignedLdpVPTokenBuilder.kt
@@ -205,10 +205,17 @@ internal class UnsignedLdpVPTokenBuilder(
         }
 
         internal fun sanitizeHolderId(holderId: String): String {
-            return holderId
+            val normalized = holderId
                 .replace("+", "-")
                 .replace("/", "_")
-                .replace("=", "") + "#0"
+                .replace("=", "")
+            val fragmentCount = normalized.count { it == '#' }
+            if (fragmentCount > 1 || (fragmentCount == 1 && !normalized.endsWith("#0"))) {
+                throw OpenID4VPExceptions.InvalidData(
+                    "Holder ID has an unsupported key fragment", className
+                )
+            }
+            return if (fragmentCount == 1) normalized else "$normalized#0"
         }
     }
 }
