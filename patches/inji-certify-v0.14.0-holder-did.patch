--- a/certify-service/src/main/java/io/mosip/certify/proof/DIDjwkProofManager.java
+++ b/certify-service/src/main/java/io/mosip/certify/proof/DIDjwkProofManager.java
@@ -71,7 +71,17 @@ public class DIDjwkProofManager implements JwtProofKeyManager {
             byte[] keyBytes = header.getJWK().toJSONString().getBytes(StandardCharsets.UTF_8);
             return Optional.of(DID_JWK_PREFIX.concat(Base64.getUrlEncoder().encodeToString(keyBytes)));
         } else if (header.getKeyID().startsWith(DID_JWK_PREFIX)) {
-            return Optional.of(header.getKeyID());
+            String keyId = header.getKeyID();
+            int fragment = keyId.indexOf('#');
+            if (fragment < 0) {
+                return Optional.of(keyId);
+            }
+            if (keyId.indexOf('#', fragment + 1) != -1 || !"#0".equals(keyId.substring(fragment))) {
+                return Optional.empty();
+            }
+            // The proof references key #0; the credential subject is the
+            // holder DID itself. Keep the fragment only in the key reference.
+            return Optional.of(keyId.substring(0, fragment));
         }
         return Optional.empty();
     }
