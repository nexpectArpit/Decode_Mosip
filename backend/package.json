{
  "name": "inji-playground-backend",
  "version": "1.0.0",
  "description": "Backend API and Protocol Inspector for Inji Interoperability Playground",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test:matrix": "node dist/cli-test-runner.js",
    "test:vp-verifier": "npm run build && node --test dist/crypto/vp-verifier.test.js",
    "test:mobile-proof-issuance": "node scripts/test-mobile-proof-issuance.mjs"
  },
  "dependencies": {
    "@digitalbazaar/credentials-context": "^3.2.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "@digitalbazaar/security-context": "^1.0.1",
    "bs58": "^6.0.0",
    "cbor": "^10.0.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonld": "^9.0.0",
    "jsonld-signatures": "^11.6.0"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/cbor": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
