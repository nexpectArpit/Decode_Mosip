# Optional environment configuration for physical Inji Mobile testing.
# By default, Docker Compose runs in local mode without needing a .env file.
# When running physical phone tests with an HTTPS tunnel (e.g. Cloudflare or localtunnel),
# set your public HTTPS domain here:
#
# CERTIFY_PUBLIC_ORIGIN=https://<your-tunnel-domain>.trycloudflare.com
# CERTIFY_PUBLIC_DID=did:web:<your-tunnel-domain>.trycloudflare.com
# VERIFY_PUBLIC_ORIGIN=https://<your-tunnel-domain>.trycloudflare.com
# VERIFY_PUBLIC_URL=https://<your-tunnel-domain>.trycloudflare.com/v1/verify
# VERIFY_PUBLIC_DID=did:web:<your-tunnel-domain>.trycloudflare.com:v1:verify
